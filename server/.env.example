# Copy this file to .env and fill in your own values.
# Never commit .env or real passwords.

# Server
PORT=5000
CLIENT_URL=http://localhost:5173
APP_TIMEZONE=Asia/Thimphu

# Database (MySQL 8) - use your personal login, see database/setup_notes.md
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=g_link

# Auth: JWT_SECRET is required. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Email (SMTP). Leave EMAIL_HOST blank in development: emails are then printed in the server log.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Integration tests (npm run test:integration). Uses a SEPARATE database that is
# dropped and re-created on every run. Your login needs rights on it:
#   GRANT ALL PRIVILEGES ON g_link_test.* TO 'glink_<name>'@'localhost';
TEST_DB_HOST=localhost
TEST_DB_PORT=3306
TEST_DB_USER=
TEST_DB_PASSWORD=
TEST_DB_NAME=g_link_test
# Folder that holds schema/ and seed/ (the database branch merged in)
SCHEMA_DIR=../database
